# Copy to .env.production and replace every CHANGE_ME / 203.0.113.10 value.
# .env.production is gitignored and must never be committed.

# --- Public domains ----------------------------------------------------------
FRONTEND_DOMAIN=example.com
BACKEND_DOMAIN=backend.example.com
CALLS_DOMAIN=callservice.example.com
# Let's Encrypt account e-mail (certificate expiry notices).
ACME_EMAIL=admin@example.com

# --- Server address ----------------------------------------------------------
# Public IPv4 address of the server. 203.0.113.10 is a documentation
# placeholder: replace it after the server is created. The STUN/TURN URLs in
# docker-compose.prod.yml are generated from this value.
SERVER_IP=203.0.113.10

# Address advertised in TURN relay candidates. Usually the same as SERVER_IP.
# If the server is behind NAT, use PUBLIC_IP/PRIVATE_IP, for example:
#   TURN_EXTERNAL_IP=203.0.113.10/10.0.0.5
TURN_EXTERNAL_IP=203.0.113.10

# --- Auth --------------------------------------------------------------------
# Must match SECRET_KEY in xam_backend. At least 16 characters.
# Generate one with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ALGORITHMS=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional OIDC overrides. Leave empty for the shared HS256 secret above.
JWT_ISSUER=
JWT_AUDIENCE=
OAUTH2_JWKS_URL=
OAUTH2_INTROSPECTION_URL=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

# --- PostgreSQL --------------------------------------------------------------
# Use an alphanumeric password: it is embedded into a connection URL.
POSTGRES_USER=xam
POSTGRES_PASSWORD=CHANGE_ME_alphanumeric_db_password
POSTGRES_DB=xam

# --- TURN --------------------------------------------------------------------
# Use an alphanumeric password: coturn expands command-line arguments through
# eval, and the calls container receives it as a static credential.
TURN_USERNAME=xam
TURN_CREDENTIAL=CHANGE_ME_alphanumeric_turn_password
TURN_REALM=xam
TURN_MIN_PORT=49160
TURN_MAX_PORT=49300

# --- Call tuning -------------------------------------------------------------
RING_TIMEOUT_SECONDS=45
DISCONNECT_GRACE_SECONDS=10
MAX_CALL_DURATION_SECONDS=14400
MAX_CONFERENCE_PARTICIPANTS=8
WS_TICKET_TTL_SECONDS=30
MAX_WS_MESSAGE_BYTES=98304
WS_IDLE_TIMEOUT_SECONDS=180
WS_SEND_TIMEOUT_SECONDS=5

# --- Media limits (backend) --------------------------------------------------
MAX_IMAGE_SIZE_BYTES=5242880
MAX_AUDIO_SIZE_BYTES=26214400
MAX_VIDEO_NOTE_SIZE_BYTES=26214400
