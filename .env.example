APP_NAME=xam_call_service
DEBUG=false

# --- OAuth2 / auth -----------------------------------------------------------
# jwt | introspect | backend
# jwt        — local JWT validation (shared HS256 secret or JWKS)
# introspect — RFC 7662 token introspection
# backend    — validate tokens through xam_backend /api/v1/users/me
AUTH_MODE=jwt

# Must match SECRET_KEY in xam_backend (.env) when AUTH_MODE=jwt and no JWKS.
SECRET_KEY=dev-secret-key-change-me-32-bytes-min
JWT_ALGORITHMS=HS256
JWT_ISSUER=
JWT_AUDIENCE=

# OIDC / OAuth2 (optional). If OAUTH2_JWKS_URL is set, RS256/ES256 tokens are
# validated with the provider public keys instead of the shared secret.
OAUTH2_JWKS_URL=
OAUTH2_INTROSPECTION_URL=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

# Fetch /users/me from xam_backend to enrich the identity with username/name.
AUTH_ENRICH_USERINFO=true
USERINFO_CACHE_TTL_SECONDS=300

# Neighboring auth/user service.
BACKEND_BASE_URL=http://localhost:8000
BACKEND_USERINFO_PATH=/api/v1/users/me
BACKEND_TIMEOUT_SECONDS=5

# --- Storage -----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./calls.db
DATABASE_ECHO=false
AUTO_CREATE_TABLES=true

# --- Calls -------------------------------------------------------------------
RING_TIMEOUT_SECONDS=45
DISCONNECT_GRACE_SECONDS=10
MAX_CALL_DURATION_SECONDS=14400
WS_TICKET_TTL_SECONDS=30
MAX_WS_MESSAGE_BYTES=98304
# Close sockets that send nothing for this long (seconds, 0 = disabled).
WS_IDLE_TIMEOUT_SECONDS=180
# Per-socket timeout for signaling/presence fan-out (seconds, 0 = wait forever).
WS_SEND_TIMEOUT_SECONDS=5

# JSON array of RTCIceServer objects. The bundled coturn service also acts as STUN.
# Replace 127.0.0.1 with the address clients actually use to reach this host.
ICE_SERVERS=[{"urls":["stun:127.0.0.1:3478","stun:stun.l.google.com:19302"]}]
# TURN is required when peers are behind symmetric NAT / CGNAT.
TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
TURN_USERNAME=xam
TURN_CREDENTIAL=xam-turn-change-me
TURN_REALM=xam
# Address advertised in relay candidates. Must be reachable by the browsers:
# LAN IP for local calls, public IP (with ports forwarded) for calls over the internet.
TURN_EXTERNAL_IP=127.0.0.1
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081,http://127.0.0.1:8081

# --- Docker: HTTP / HTTPS ----------------------------------------------------
# Plain HTTP is published directly from the calls service.
CALLS_PORT=8081
# HTTPS is terminated by the calls-tls nginx sidecar with a self-signed cert.
CALLS_TLS_PORT=8443
# Comma-separated names/IPs written into the certificate SAN. Add the LAN IP
# you open the client from, e.g. TLS_HOSTS=localhost,127.0.0.1,192.168.1.50
TLS_HOSTS=localhost,127.0.0.1
TLS_CN=localhost
TLS_CERT_DAYS=825
# Set to 1 to regenerate the certificate on the next container start.
TLS_REGENERATE=0
